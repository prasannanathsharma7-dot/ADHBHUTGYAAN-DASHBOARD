# Copy this to .env locally (never commit the real .env file)

# MongoDB Atlas connection string
# Used in: scraper/youtube_worker.py, nlp/batch_pipeline.py, dashboard/app/api/analytics/route.ts
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Anthropic API key for the Batch API enrichment pipeline
# Used in: nlp/batch_pipeline.py (picked up automatically by the anthropic SDK
# from this env var — no need to paste it into the code)
ANTHROPIC_API_KEY=sk-ant-...
