# Copy this to .env locally (never commit the real .env file).
# This pipeline is HARD-ISOLATED to the astrology_intelligence database.
# See mongo/db_guard.py — it refuses to run against anything else,
# including the production website database (astrokashi).

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Do not set this unless you mean it — see mongo/db_guard.py.
MONGO_DB_NAME=astrology_intelligence

# Anthropic API key for the Claude Batch API enrichment pipeline.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if you run scraper/youtube_worker.py via real Celery
# workers (full 1M-comment bulk load) rather than scripts/run_local_pipeline.py.
CELERY_BROKER_URL=redis://localhost:6379/0
